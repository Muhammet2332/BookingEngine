@BookingEngine_HostAddress = http://localhost:5010

### GET All Bookings by Client
GET {{BookingEngine_HostAddress}}/bookings
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..VlMLdmh5ixGd_Ypgjl7nnM66cDbLcHTfRmF-VtkLXJg

### GET All Bookings by Admin
GET {{BookingEngine_HostAddress}}/bookings
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..GmpXSLimc4XE_Ikt0lWPY_5MmB8EsxzpG8xRzg9myYc

### GET Booking by ID
GET {{BookingEngine_HostAddress}}/bookings/1
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..VlMLdmh5ixGd_Ypgjl7nnM66cDbLcHTfRmF-VtkLXJg

### POST Create New Booking
POST {{BookingEngine_HostAddress}}/bookings
Content-Type: application/json

{
  "roomId": 1,
  "CustomerName": "user2",
  "StartDate": "2026-04-01",
  "EndDate": "2026-04-07"
}

###
PUT {{BookingEngine_HostAddress}}/bookings/1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..VlMLdmh5ixGd_Ypgjl7nnM66cDbLcHTfRmF-VtkLXJg

{
  "roomId": 1,
  "CustomerName": "user1",
  "StartDate": "2026-09-01",
  "EndDate": "2026-09-05"
}

### DELETE Booking
DELETE {{BookingEngine_HostAddress}}/bookings/6
